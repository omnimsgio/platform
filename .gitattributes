# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.json text
*.yaml text
*.yml text
*.toml text
*.xml text
*.html text
*.css text
*.js text
*.jsx text
*.ts text
*.tsx text
*.py text
*.go text
*.sh text
*.sql text
Dockerfile text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
