# OmniMsg local / compose environment (ADR-0009). Copy to `.env` — never commit secrets.

# Postgres on shared data stack (`postgis`). Provision DB/role via scripts/provision-local-db.sh.
DATABASE_URL=postgresql://omnimsgio:CHANGE_ME@postgis:5432/omnimsgio

# Redis on shared redis stack (`infra-redis`), logical DB 3 (OmniMsg).
REDIS_URL=redis://infra-redis:6379/3
REDIS_KEY_PREFIX=omnimsgio:

# Queue / event key suffixes appended to REDIS_KEY_PREFIX.
REDIS_QUEUE_OUTBOUND=queue:outbound
REDIS_QUEUE_INBOUND=queue:inbound
REDIS_EVENTS_DELIVERY=events:delivery

# Upstream API base URL used by the gateway proxy (unique service DNS — avoid bare `api`).
API_URL=http://omnimsgio-api:8000

# Local seed tenant (scripts/seed-local-tenant.sh). Optional SEED_API_KEY overrides generation.
DEFAULT_TENANT_ID=ten_local_dev
# SEED_API_KEY=omni_replace_me

# Fixed-window rate limit per API key (gateway Redis).
RATE_LIMIT_PER_MINUTE=60
# Browser Origins allowed to call the public API (portal Connect WhatsApp).
CORS_ALLOWED_ORIGINS=https://app.omnimsg.io,https://omnimsgio-app.localhost

# Meta WhatsApp Cloud API (Solution Partner / development app).
# Prepare for gateway webhook verify + signature (channels slice).
# Callback (local Traefik): https://omnimsgio.localhost/webhooks/meta/whatsapp
# Callback (production):    https://api.omnimsg.io/webhooks/meta/whatsapp
# Ops tracking (IDs, application status): /opt/stacks/ops/omnimsgio-meta-sp-kickoff.md
# Production bring-up: docs/runbooks/production-gateway.md
# OmniMsg app (Finestar Hospitality) — non-secret IDs are safe to keep; secrets never commit.
META_APP_ID=3492919917530282
META_BUSINESS_ID=1329905112443890
META_VERIFY_TOKEN=change_me_hub_verify_token
META_APP_SECRET=change_me_from_meta_app_dashboard
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Embedded Signup login config (Meta App Dashboard → Facebook Login for Business).
META_ES_CONFIG_ID=893783150448062
# Portal feature flag (runtime on web service; set true to show Connect WhatsApp).
FEATURE_EMBEDDED_SIGNUP=false
# Meta ES extras.featureType: empty = classic; whatsapp_business_app_onboarding = coexistence.
WHATSAPP_ES_FEATURE_TYPE=
# Public API base used by portal ES complete calls.
API_BASE_URL=https://api.omnimsg.io
# Optional Sentry DSN for API exception capture (correlation_id tagged).
SENTRY_DSN=

APP_VERSION=0.1.0
# Runtime label for discovery /version (development|production|…).
APP_ENV=development
# Build metadata (set by CI/image build; unknown is fine locally).
GIT_SHA=unknown
BUILD_DATE=unknown
# Optional override; Docker images default to /app/packages/contracts/openapi/openapi.yaml
# OPENAPI_CONTRACT_PATH=
LOG_LEVEL=INFO
