# OmniMsg local / compose environment (ADR-0009). Copy to `.env` — never commit secrets.

# Postgres on shared data stack (`postgis`). Provision DB/role via scripts/provision-local-db.sh.
DATABASE_URL=postgresql://omnimsgio:CHANGE_ME@postgis:5432/omnimsgio

# Redis on shared redis stack (`infra-redis`), logical DB 3 (OmniMsg).
REDIS_URL=redis://infra-redis:6379/3
REDIS_KEY_PREFIX=omnimsgio:

# Queue / event key suffixes appended to REDIS_KEY_PREFIX.
REDIS_QUEUE_OUTBOUND=queue:outbound
REDIS_EVENTS_DELIVERY=events:delivery

# Upstream API base URL used by the gateway proxy (Docker service DNS).
API_URL=http://api:8000

# Local seed tenant (scripts/seed-local-tenant.sh). Optional SEED_API_KEY overrides generation.
DEFAULT_TENANT_ID=ten_local_dev
# SEED_API_KEY=omni_replace_me

# Fixed-window rate limit per API key (gateway Redis).
RATE_LIMIT_PER_MINUTE=60

APP_VERSION=0.1.0
LOG_LEVEL=INFO
